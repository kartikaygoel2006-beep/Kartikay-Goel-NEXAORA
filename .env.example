# Supabase project settings — find these in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL, used for sitemap.xml and robots.txt. Set this to your
# production Vercel URL (or custom domain) once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
